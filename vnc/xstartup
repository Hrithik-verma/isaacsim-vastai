#!/bin/sh
# KasmVNC session startup — launch a KDE Plasma desktop.
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KDE
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

[ -r "$HOME/.Xresources" ] && xrdb "$HOME/.Xresources"

# Disable the screen locker (no login manager wired up in this VNC session,
# a locked session would be unrecoverable) and the compositor's own
# "another compositing manager" nags with KasmVNC's own X server.
export KDE_SKIP_SCREENSAVER=1

# startplasma-x11 runs in the foreground and keeps the VNC session alive.
exec dbus-launch --exit-with-session startplasma-x11
